#!/usr/bin/env bash
# Mock getent for download.sh tests. Returns MOCK_GETENT_IPS (default a public
# address), or fails when MOCK_GETENT_FAIL is set. Emulates `getent ahostsv4`
# output lines: "<ip> STREAM".
set -u

if [[ "${MOCK_GETENT_FAIL:-0}" == "1" ]]; then
  exit 2
fi
printf '%s\n' "${MOCK_GETENT_IPS:-93.184.216.34 STREAM}"
exit 0