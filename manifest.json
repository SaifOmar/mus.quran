{
  "schemaVersion": 1,
  "id": "mus.quran",
  "name": "Quran",
  "version": "0.5.1",
  "author": "Saif",
  "license": "MIT",
  "description": "Quran recitation player with reciter and surah selection. Requires mpv (with mpv-mpris for system media control).",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Quran",
    "description": "Quran recitation player",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
